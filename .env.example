# ===== AI お絵描き 設定ファイル =====
# .env という名前でコピーして使います（.env は Git に入れないこと）
# ※ アプリの管理画面（タイトル長押し → 暗証番号 → 環境設定）からも編集できます
#
# サーバー版：ホスティング（Render など）の「環境変数」に同じ項目を設定します

# --- 共通 ---
# Gemini API キー（空でも、起動後に管理画面から入力できます）
GEMINI_API_KEY=
# 使うモデル（管理画面からも変更できます）
GEMINI_MODEL=gemini-3.1-pro-preview
# 管理画面の暗証番号（数字4桁）
ADMIN_PIN=0001

# --- サーバー版（ドメインで公開） ---
# Windows PC の Chrome でログインするときの ID・パスワード（公開時は必須）
APP_USER=
APP_PASSWORD=

# --- PC 版（exe・オフライン） ---
# browser = Chrome の全画面ロック / window = 従来のアプリウィンドウ
LAUNCH_MODE=browser
# Alt+Tab / Alt+F4 / Ctrl+W などを無効化する（1=する / 0=しない）。Windowsキーは常に有効
KIOSK_BLOCK_KEYS=1
# Chrome が標準の場所にない場合だけ指定
CHROME_PATH=
# window モードで全画面にするか
FULLSCREEN=1
