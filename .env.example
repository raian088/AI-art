# ===== AI お絵描き 設定ファイル =====
# このファイルを .env という名前でコピーして使います（.env は Git に入れないこと）

# Gemini API キー（必須）
GEMINI_API_KEY=

# 使うモデル（管理画面からも変更できます）
GEMINI_MODEL=gemini-3.1-pro-preview

# 起動方法: browser = Chrome の全画面ロック（キオスク） / window = 従来のアプリウィンドウ
LAUNCH_MODE=browser

# 管理画面の暗証番号（タイトル2秒長押し → 入力）
ADMIN_PIN=0001

# ロック中に Alt+Tab / Alt+F4 / Ctrl+W などを無効化する（1=する / 0=しない）。Windowsキーは常に有効
KIOSK_BLOCK_KEYS=1

# Chrome が標準の場所にない場合だけ指定（例: C:\Program Files\Google\Chrome\Application\chrome.exe）
CHROME_PATH=

# window モードで全画面にするか（1=全画面 / 0=ウィンドウ）
FULLSCREEN=1
